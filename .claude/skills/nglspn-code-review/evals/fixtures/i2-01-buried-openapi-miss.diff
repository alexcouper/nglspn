diff --git a/src/django-backend/apps/articles/models.py b/src/django-backend/apps/articles/models.py
index aa11bb2..cc33dd4 100644
--- a/src/django-backend/apps/articles/models.py
+++ b/src/django-backend/apps/articles/models.py
@@ -120,6 +120,15 @@ class Article(models.Model):
     def __str__(self) -> str:
         return self.title or f"Article {self.id}"

+    @property
+    def reading_time_minutes(self) -> int:
+        """Estimated reading time, ~200 words per minute, min 1."""
+        word_count = len(self.body.split())
+        return max(1, round(word_count / 200))
+
