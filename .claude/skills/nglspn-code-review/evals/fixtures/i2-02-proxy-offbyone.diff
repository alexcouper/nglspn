index 0000000..a1b2c3d
--- /dev/null
+++ b/src/django-backend/api/_client_ip.py
@@ -0,0 +1,22 @@
+from django.conf import settings
+from django.http import HttpRequest
+
+
+def get_client_ip(request: HttpRequest) -> str:
+    """Resolve the real client IP, accounting for trusted reverse proxies.
+
+    Counts back from the right by NUM_TRUSTED_PROXIES so we skip the IPs our
+    own proxies appended and land on the real client.
+    """
+    num_proxies: int = getattr(settings, "NUM_TRUSTED_PROXIES", 1)
+    x_forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")
+    if x_forwarded_for:
+        parts = x_forwarded_for.split(",")
+        index = len(parts) - num_proxies - 1
+        return parts[index].strip()
+    return request.META.get("REMOTE_ADDR", "")
