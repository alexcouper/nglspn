{% comment %}
One title-plus-excerpt row per article. Shared by the list layout
(article_digest.mjml) and the lead layout (article_digest_lead.mjml), where it
renders the articles after the lead. Rendered by Django before mjml compiles,
so a plain include is enough.
{% endcomment %}
{% for entry in entries %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
  <tr>
    <td style="{% if not forloop.first %}border-top: 1px solid #f1f5f9; padding-top: 18px;{% endif %}{% if not forloop.last %}padding-bottom: 18px;{% endif %}">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
        <tr>
          {% if entry.article_image_url %}
          <td width="56" valign="top" style="padding-right: 12px;">
            <a href="{{ entry.article_url }}" style="text-decoration: none;">
              <img src="{{ entry.article_image_url }}" alt="" width="56" height="56" style="display: block; width: 56px; height: 56px; border-radius: 8px; object-fit: cover; border: 0;" />
            </a>
          </td>
          {% endif %}
          <td valign="top">
            {% if entry.channel_name %}<p style="margin: 0 0 2px; font-size: 12px; color: #6366f1; text-transform: uppercase; letter-spacing: 0.06em;">{{ entry.channel_name }}</p>{% endif %}
            <p style="margin: 0; font-size: 17px; line-height: 1.4;">
              <a href="{{ entry.article_url }}" style="color: #0f172a; font-weight: 600; text-decoration: none;">{{ entry.article_title }}</a>
            </p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">
              {% if entry.project_title %}on <a href="{{ entry.project_url }}" style="color: #64748b; text-decoration: none;">{{ entry.project_title }}</a>{% else %}by <a href="{{ entry.author_url }}" style="color: #64748b; text-decoration: none;">{{ entry.author_name }}</a>{% endif %}
            </p>
          </td>
        </tr>
      </table>
      <p style="margin: 8px 0 0; font-size: 14px; line-height: 1.6; color: #334155;">{{ entry.body_excerpt }}</p>
    </td>
  </tr>
</table>
{% endfor %}
