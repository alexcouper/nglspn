{% extends "email/base.mjml" %}

{% block title %}New articles - Naglasúpan{% endblock %}

{% block content %}
<mj-section background-color="#ffffff" border-radius="12px" padding="0">
  <mj-column>
    <mj-text padding="28px 32px 20px">
      <p style="margin: 0 0 2px; font-size: 12px; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.06em;">New articles</p>
      <p style="margin: 0; font-size: 20px; font-weight: 700; color: #0f172a; line-height: 1.3;">
        Hi {{ recipient_name }}, here's what's been published
      </p>
    </mj-text>
    <mj-divider border-color="#f1f5f9" border-width="1px" padding="0 32px" />
    <mj-text padding="24px 32px 0">
      {% for entry in entries %}
      <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
        <tr>
          <td style="{% if not forloop.first %}border-top: 1px solid #f1f5f9; padding-top: 18px;{% endif %}{% if not forloop.last %}padding-bottom: 18px;{% endif %}">
            <p style="margin: 0 0 2px; font-size: 12px; color: #6366f1; text-transform: uppercase; letter-spacing: 0.06em;">{{ entry.channel_name }}</p>
            <p style="margin: 0; font-size: 17px; line-height: 1.4;">
              <a href="{{ entry.article_url }}" style="color: #0f172a; font-weight: 600; text-decoration: none;">{{ entry.article_title }}</a>
            </p>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">on {{ entry.project_title }}</p>
            <p style="margin: 8px 0 0; font-size: 14px; line-height: 1.6; color: #334155;">{{ entry.body_excerpt }}</p>
          </td>
        </tr>
      </table>
      {% endfor %}
    </mj-text>
    <mj-button href="{{ site_url }}" align="center" padding="24px 32px 28px" width="100%">
      View on Naglasúpan
    </mj-button>
  </mj-column>
</mj-section>
{% endblock %}

{% block footer_extra %}
<mj-text align="center" font-size="12px" color="#94a3b8" padding="0 0 12px">
  You can <a href="{{ profile_url }}" style="color: #6366f1; text-decoration: underline;">change your article email frequency</a> in your profile settings.
</mj-text>
{% endblock %}
