{% extends "email/base.mjml" %}

{% block title %}New article on {{ project_title }} - Naglasúpan{% endblock %}

{% block content %}
<mj-section background-color="#ffffff" border-radius="12px" padding="0">
  <mj-column>
    <!-- Card header -->
    <mj-text padding="28px 32px 20px">
      <p style="margin: 0 0 2px; font-size: 12px; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.06em;">{{ channel_name }}</p>
      <p style="margin: 0; font-size: 22px; font-weight: 700; color: #0f172a; line-height: 1.3;">
        <a href="{{ article_url }}" style="color: #0f172a; text-decoration: none;">{{ article_title }}</a>
      </p>
      <p style="margin: 6px 0 0; font-size: 13px; color: #64748b;">on {{ project_title }}</p>
    </mj-text>
    <mj-divider border-color="#f1f5f9" border-width="1px" padding="0 32px" />
    <!-- Body excerpt -->
    <mj-text padding="20px 32px 0">
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #334155;">{{ body_excerpt }}</p>
    </mj-text>
    <!-- CTA -->
    <mj-button href="{{ article_url }}" align="center" padding="24px 32px 28px" width="100%">
      Read article
    </mj-button>
  </mj-column>
</mj-section>
{% endblock %}

{% block footer_extra %}
<mj-text align="center" font-size="12px" color="#94a3b8" padding="0 0 12px">
  You're receiving this because you follow {{ project_title }}.
  <a href="{{ project_url }}" style="color: #6366f1; text-decoration: underline;">Manage your preferences</a>.
</mj-text>
{% endblock %}
