{% extends "email/base.mjml" %}

{% block title %}A problem was reported with {{ project_title }} - Naglasúpan{% endblock %}

{% block content %}
<mj-section background-color="#ffffff" border-radius="12px" padding="0">
  <mj-column>
    <mj-text padding="28px 32px 20px">
      <p style="margin: 0 0 2px; font-size: 12px; font-weight: 600; color: #d97706; text-transform: uppercase; letter-spacing: 0.06em;">Problem reported</p>
      <p style="margin: 0; font-size: 20px; font-weight: 700; color: #0f172a; line-height: 1.3;">
        <a href="{{ project_url }}" style="color: #0f172a; text-decoration: none;">{{ project_title }}</a>
      </p>
    </mj-text>
    <mj-divider border-color="#f1f5f9" border-width="1px" padding="0 32px" />
    <mj-text padding="24px 32px 0">
      <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #334155;">
        {% if is_maker %}Hi {{ recipient_name }}, a visitor on Naglasúpan tried your project and says something isn't working.{% else %}A visitor reported a problem with this project. It has no maker on Naglasúpan to tell, so the report came to you.{% endif %}
      </p>
      <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;">
        <tr>
          <td style="padding: 16px 20px;">
            <p style="margin: 0; font-size: 15px; font-weight: 600; color: #92400e;">{{ reason }}</p>
            {% if details %}<p style="margin: 8px 0 0; font-size: 15px; line-height: 1.7; color: #334155; white-space: pre-line;">{{ details }}</p>{% endif %}
          </td>
        </tr>
      </table>
      <p style="margin: 16px 0 0; font-size: 14px; line-height: 1.6; color: #64748b;">
        {% if contact_email %}They left an address in case you have questions &mdash; reply to this email to reach them.{% else %}They didn't leave a contact address.{% endif %}
      </p>
    </mj-text>
    <mj-button href="{{ website_url }}" align="center" padding="24px 32px 8px" width="100%">
      Check the site
    </mj-button>
    <mj-text align="center" font-size="13px" color="#64748b" padding="8px 32px 28px">
      {% if is_maker %}Moved it, or retired it? <a href="{{ edit_url }}" style="color: #6366f1; text-decoration: underline;">Update the project</a> so visitors land in the right place.{% else %}<a href="{{ project_url }}" style="color: #6366f1; text-decoration: underline;">View the project on Naglasúpan</a>{% endif %}
    </mj-text>
  </mj-column>
</mj-section>
{% endblock %}
